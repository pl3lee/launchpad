# Optional numeric PIN. Leave empty to disable authentication.
# Keep it quoted to make leading zeroes explicit.
PIN=""

# Set to the public HTTPS origin when using a reverse proxy.
# This enables Secure cookies behind TLS termination.
# Example: APP_ORIGIN=https://launchpad.example.com
APP_ORIGIN=

# Bind to localhost by default. Use 0.0.0.0 for trusted LAN access.
BIND_ADDRESS=127.0.0.1
PORT=8080
